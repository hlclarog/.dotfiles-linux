# The AI CLIs. These are casks, which `brew bundle dump --brews`
# silently omits - that omission is why a restore came up without them.
#
# Homebrew 7 refuses to load ANY entry from an untrusted third-party tap. Its
# bundle code only ever applies `trusted: true` to a FULLY QUALIFIED name
# (Utils.full_name? in Library/Homebrew/bundle/{brew,cask}.rb), so a bare
# `cask "openai"` is never recognized as belonging to the openai/tools tap and
# the trust flag is silently ignored. Every entry from a third-party tap must
# therefore be written as tap/name AND marked trusted: true.
# Claude Code CLI
cask "claude-code"
# OpenAI Codex CLI
cask "codex"
# OpenAI CLI
cask "openai/tools/openai", trusted: true

# Runtime libraries that nothing else in this file depends on, kept declared
# so `brew bundle dump` round-trips cleanly instead of re-adding them every
# time. alsa-lib backs herdr notification sounds; nss backs headless Chrome.
brew "alsa-lib"
brew "nss"
# PostgreSQL client for the Engram databases in ~/.pgpass. Keg-only, so psql
# never lands on PATH; reach it at
# /home/linuxbrew/.linuxbrew/opt/libpq/bin/psql or add that bin to PATH by hand.
brew "libpq"
