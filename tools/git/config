# Reference copy of ~/.ssh/config.
#
# The SSH user for GitHub and Bitbucket is always "git" — never the account
# name. Setting User to the account name fails on `ssh -T <host>` and on any
# remote URL written without the git@ prefix.

Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/github-hlclarog
  IdentitiesOnly yes
  AddKeysToAgent yes

Host bitbucket.org
  HostName bitbucket.org
  User git
  IdentityFile ~/.ssh/bit-hclaro
  IdentitiesOnly yes
  AddKeysToAgent yes
