#!/usr/bin/env bash
# Guided walkthrough for the manual logins, keys and sudo-gated steps that
# `dot self install` deliberately leaves undone: it runs unattended and must
# never block on a browser login or a sudo password prompt.
#
# Run by hand, interactively:  ./scripts/post-restore-secrets
# Status only, no prompts:     ./scripts/post-restore-secrets --check
# Interactive account switcher: ./scripts/post-restore-secrets --menu
# Skip the account probes:      ./scripts/post-restore-secrets --no-accounts
# One step only:                POST_RESTORE_ONLY=<step-id> ./scripts/post-restore-secrets
set -u

DOTFILES_PATH="${DOTFILES_PATH:-$HOME/.dotfiles}"
NO_ACCOUNTS="${NO_ACCOUNTS:-0}"

STEP_ORDER=(gh ssh-keys pi claude codex opencode engram-cloud tailscale zerotier sshd shell moshi)
declare -A STEP_LABEL=(
	[gh]="GitHub CLI"
	[ssh-keys]="SSH keys"
	[pi]="Pi (OpenAI login)"
	[claude]="Claude Code"
	[codex]="Codex"
	[opencode]="opencode"
	[engram-cloud]="Engram cloud"
	[tailscale]="Tailscale"
	[zerotier]="ZeroTier (optional fallback)"
	[sshd]="sshd hardening"
	[shell]="Login shell"
	[moshi]="Moshi pairing"
)
declare -A RESULT=()
declare -A ACCOUNT_RESULT=()

# --- input: prefer a real controlling terminal, fall back to stdin ---------
# A prompt must work when piped answers arrive over SSH with no /dev/tty, and
# also when a real terminal is attached but stdin is otherwise occupied. A
# plain `[ -r /dev/tty ]` can be true even with no controlling terminal at
# all, so availability is tested by actually opening it. The test runs in a
# subshell (its own stderr silenced from the outside) rather than a bare
# `exec ... 2>/dev/null`, because a failed redirection on a bare `exec`
# reports its error before later redirections in the same command take
# effect -- `2>/dev/null` would never suppress it, and would otherwise
# redirect this shell's stderr to /dev/null permanently once opening did
# succeed.
have_tty() { (exec 3</dev/tty) 2>/dev/null; }

ask_yn() {
	local prompt="$1" default="${2:-Y}" reply suffix
	suffix="[Y/n]"
	[ "$default" = "N" ] && suffix="[y/N]"
	if have_tty; then
		exec 3</dev/tty
		read -r -p "$prompt $suffix " reply <&3
		exec 3<&-
	else
		printf '%s %s ' "$prompt" "$suffix"
		read -r reply
	fi
	[ -z "$reply" ] && reply="$default"
	case "$reply" in
	[Yy]*) return 0 ;;
	*) return 1 ;;
	esac
}

read_visible() {
	# The prompt is written to stderr (never stdout): this function's return
	# value travels through a `$(...)` capture, and stdout is exactly what
	# that capture would swallow.
	local prompt="$1" value
	if have_tty; then
		exec 3</dev/tty
		read -r -p "$prompt " value <&3
		exec 3<&-
	else
		printf '%s ' "$prompt" >&2
		read -r value
	fi
	printf '%s' "$value"
}

read_secret() {
	local prompt="$1" value
	if have_tty; then
		exec 3</dev/tty
		read -rs -p "$prompt " value <&3
		printf '\n' >/dev/tty
		exec 3<&-
	else
		printf '%s ' "$prompt" >&2
		read -rs value
		printf '\n' >&2
	fi
	printf '%s' "$value"
}

login_shell_of() {
	if [ "$(uname -s)" = Darwin ]; then
		dscl . -read "/Users/$1" UserShell 2>/dev/null | awk '{print $2}'
	else
		getent passwd "$1" 2>/dev/null | awk -F: '{print $7}'
	fi
}

# --- ssh/config parsing -------------------------------------------------------
# Emits "<host><TAB><identity-file>" lines, one per IdentityFile, in file
# order, with ~ expanded to $HOME. Not a full ssh_config parser -- just enough
# to recover the (Host, IdentityFile) pairs this repository's config uses.
list_identity_files() {
	local config="$1" host="" clean key val
	[ -f "$config" ] || return 0
	while IFS= read -r line || [ -n "$line" ]; do
		clean=$(printf '%s' "$line" | sed -E 's/#.*$//; s/^[[:space:]]+//; s/[[:space:]]+$//')
		[ -z "$clean" ] && continue
		key=${clean%% *}
		val=${clean#* }
		case "$key" in
		[Hh][Oo][Ss][Tt]) host="$val" ;;
		[Ii][Dd][Ee][Nn][Tt][Ii][Tt][Yy][Ff][Ii][Ll][Ee])
			# Matching a literal leading "~/" is the point: an unquoted ~/* here
			# would itself tilde-expand at parse time and then never match a
			# value that still has a literal tilde.
			# shellcheck disable=SC2088
			case "$val" in
			"~/"*) val="$HOME/${val#\~/}" ;;
			"~") val="$HOME" ;;
			esac
			printf '%s\t%s\n' "$host" "$val"
			;;
		esac
	done <"$config"
}

# --- account detection: read-only, best-effort, never prints secrets --------
# Every probe below runs non-interactively (stdin /dev/null), bounded by
# `timeout 10` when available, with stderr discarded; any failure -- missing
# tool, no network, empty/missing file, unparseable output -- degrades to "-"
# rather than raising an error. This keeps `--check`/`--menu` safe to run
# repeatedly and offline.
run_probe() {
	if command -v timeout >/dev/null 2>&1; then
		timeout 10 "$@" </dev/null 2>/dev/null
	else
		"$@" </dev/null 2>/dev/null
	fi
}
# Same as run_probe, but keeps stderr for tools that answer there.
run_probe_all() {
	if command -v timeout >/dev/null 2>&1; then
		timeout 10 "$@" </dev/null 2>&1
	else
		"$@" </dev/null 2>&1
	fi
}

# Decodes a JWT's payload (second dot-segment, base64url, unpadded) into JSON
# on stdout, without verifying the signature -- this only ever reads claims
# already held locally to label an account, never to authenticate anything.
decode_jwt_field() {
	local token="$1" payload
	command -v python3 >/dev/null 2>&1 || return 1
	payload=$(printf '%s' "$token" | cut -d. -f2)
	[ -n "$payload" ] || return 1
	python3 -c '
import sys, base64, json
payload = sys.argv[1]
payload += "=" * (-len(payload) % 4)
try:
    data = json.loads(base64.urlsafe_b64decode(payload))
except Exception:
    sys.exit(1)
print(json.dumps(data))
' "$payload" 2>/dev/null
}

account_gh() {
	local out name
	out=$(run_probe gh auth status)
	name=$(printf '%s' "$out" | grep -oE 'account [^ ]+' | head -1 | awk '{print $2}')
	[ -n "$name" ] && printf '%s' "$name" || echo "-"
}

# One label per Host entry that has an existing private key: the GitHub one
# is verified live (its comment is not a reliable account label), every other
# host is labeled from its own public key's comment.
account_ssh_entry() {
	local host="$1" path="$2" out name rest first_word label
	if [ "$host" = "github.com" ]; then
		# ssh prints the "Hi <name>!" greeting on stderr, which run_probe drops.
		out=$(run_probe_all ssh -T -o BatchMode=yes -o ConnectTimeout=8 git@github.com)
		name=$(printf '%s' "$out" | grep -oE 'Hi [^!]+!' | head -1 | sed -E 's/^Hi //; s/!$//')
		[ -n "$name" ] && printf 'github:%s' "$name"
		return
	fi
	[ -f "${path}.pub" ] || return 0
	rest=$(cut -d' ' -f3- "${path}.pub" 2>/dev/null)
	if [ -z "$rest" ]; then
		printf '%s:unlabeled' "$host"
		return
	fi
	first_word=${rest%% *}
	label=${rest#"$first_word"}
	label=${label# }
	if [ -z "$label" ] || [ "$label" = "$rest" ]; then
		printf '%s:unlabeled' "$host"
	else
		printf '%s:%s' "$host" "$label"
	fi
}

account_ssh_keys() {
	local config="$DOTFILES_PATH/ssh/config" entries entry host path acc parts=()
	mapfile -t entries < <(list_identity_files "$config")
	for entry in "${entries[@]}"; do
		IFS=$'\t' read -r host path <<<"$entry"
		[ -z "$path" ] && continue
		[ -f "$path" ] || continue
		acc=$(account_ssh_entry "$host" "$path")
		[ -n "$acc" ] && parts+=("$acc")
	done
	if [ "${#parts[@]}" -eq 0 ]; then
		echo "-"
	else
		local IFS=', '
		echo "${parts[*]}"
	fi
}

account_claude() {
	local out email org
	out=$(run_probe claude auth status)
	email=$(printf '%s' "$out" | jq -r '.email // empty' 2>/dev/null)
	[ -z "$email" ] && { echo "-"; return; }
	org=$(printf '%s' "$out" | jq -r 'if (.orgName? | type) == "string" and (.orgName | length > 0) then .orgName else empty end' 2>/dev/null)
	if [ -n "$org" ]; then
		echo "$email ($org)"
	else
		echo "$email"
	fi
}

account_codex() {
	local f="$HOME/.codex/auth.json" token claims email
	[ -f "$f" ] || { echo "-"; return; }
	token=$(jq -r '.tokens.id_token // empty' "$f" 2>/dev/null)
	[ -z "$token" ] && { echo "-"; return; }
	claims=$(decode_jwt_field "$token")
	[ -z "$claims" ] && { echo "-"; return; }
	email=$(printf '%s' "$claims" | jq -r '.email // empty' 2>/dev/null)
	[ -z "$email" ] && { echo "-"; return; }
	echo "$email"
}

account_pi() {
	local f="$HOME/.pi/agent/auth.json" token claims email
	[ -f "$f" ] || { echo "-"; return; }
	token=$(jq -r '.["openai-codex"].access // empty' "$f" 2>/dev/null)
	[ -z "$token" ] && { echo "-"; return; }
	claims=$(decode_jwt_field "$token")
	[ -z "$claims" ] && { echo "-"; return; }
	email=$(printf '%s' "$claims" | jq -r '.["https://api.openai.com/profile"].email // empty' 2>/dev/null)
	[ -z "$email" ] && { echo "-"; return; }
	echo "$email"
}

account_opencode() {
	local f="$HOME/.local/share/opencode/auth.json" keys
	[ -s "$f" ] || { echo "-"; return; }
	keys=$(jq -r 'keys | join(", ")' "$f" 2>/dev/null)
	[ -z "$keys" ] && { echo "-"; return; }
	echo "$keys"
}

account_engram() {
	local f="$HOME/.engram/cloud.json" url host
	[ -f "$f" ] || { echo "-"; return; }
	url=$(jq -r '.server_url // empty' "$f" 2>/dev/null)
	[ -z "$url" ] && { echo "-"; return; }
	host=$(printf '%s' "$url" | sed -E 's#^[A-Za-z][A-Za-z0-9+.-]*://##; s#/.*$##; s#:.*$##')
	[ -z "$host" ] && { echo "-"; return; }
	echo "$host"
}

account_tailscale() {
	if [ "$(uname -s)" = Darwin ]; then
		echo "-"
		return
	fi
	if grep -qi microsoft "${POST_RESTORE_PROC_VERSION_FILE:-/proc/version}" 2>/dev/null; then
		echo "-"
		return
	fi
	local out login
	out=$(run_probe tailscale status --json)
	login=$(printf '%s' "$out" | jq -r '.User[(.Self.UserID|tostring)].LoginName // empty' 2>/dev/null)
	[ -z "$login" ] && { echo "-"; return; }
	echo "$login"
}

account_moshi() {
	command -v moshi-hook >/dev/null 2>&1 || { echo "-"; return; }
	local out name
	out=$(run_probe moshi-hook status)
	name=$(printf '%s' "$out" | grep -iE '^display name:' | head -1 | sed -E 's/^[Dd]isplay [Nn]ame:[[:space:]]*//')
	[ -z "$name" ] && { echo "-"; return; }
	echo "$name"
}

account_shell() {
	local sh
	sh=$(login_shell_of "$(id -un)")
	[ -z "$sh" ] && { echo "-"; return; }
	echo "$sh"
}

account_of() {
	case "$1" in
	gh) account_gh ;;
	ssh-keys) account_ssh_keys ;;
	pi) account_pi ;;
	claude) account_claude ;;
	codex) account_codex ;;
	opencode) account_opencode ;;
	engram-cloud) account_engram ;;
	tailscale) account_tailscale ;;
	moshi) account_moshi ;;
	shell) account_shell ;;
	*) echo "-" ;;
	esac
}

populate_accounts() {
	local id
	for id in "${STEP_ORDER[@]}"; do
		if [ "${NO_ACCOUNTS:-0}" = 1 ]; then
			ACCOUNT_RESULT[$id]="-"
		else
			ACCOUNT_RESULT[$id]=$(account_of "$id")
		fi
	done
}

# --- per-step status probes ---------------------------------------------------
# Every check_* function is a pure status probe: no login, no mutation, safe
# to call from --check. Each echoes one of: done | pending | skip:<reason> |
# info:<reason>. "info" is used only by moshi, whose pairing is optional and
# must never fail --check even when it is genuinely unpaired.

check_gh() { gh auth status >/dev/null 2>&1 && echo "done" || echo "pending"; }

check_ssh_keys() {
	local config any_key=0 any_missing=0 host path
	config="$DOTFILES_PATH/ssh/config"
	while IFS=$'\t' read -r host path; do
		[ -z "$path" ] && continue
		any_key=1
		[ -f "$path" ] || any_missing=1
	done < <(list_identity_files "$config")
	if [ "$any_key" = 0 ]; then
		echo "done"
		return
	fi
	if [ "$any_missing" = 1 ]; then
		echo "pending"
		return
	fi
	if list_identity_files "$config" | cut -f1 | grep -qx github.com; then
		if ssh -T -o BatchMode=yes git@github.com 2>&1 | grep -qF 'successfully authenticated'; then
			echo "done"
		else
			echo "pending"
		fi
	else
		echo "done"
	fi
}

check_pi() { jq -e 'has("openai-codex")' "$HOME/.pi/agent/auth.json" >/dev/null 2>&1 && echo "done" || echo "pending"; }

check_claude() {
	local out
	out=$(claude auth status 2>&1)
	case "$out" in
	*'"loggedIn": true'*) echo "done" ;;
	*) echo "pending" ;;
	esac
}

check_codex() { codex login status >/dev/null 2>&1 && echo "done" || echo "pending"; }

check_opencode() {
	local f="$HOME/.local/share/opencode/auth.json"
	[ -s "$f" ] && jq -e 'type == "object" and (length > 0)' "$f" >/dev/null 2>&1 && echo "done" || echo "pending"
}

check_engram() {
	local f="$HOME/.engram/cloud.json"
	if [ -f "$f" ] && engram cloud status 2>&1 | grep -qF 'Auth status: ready'; then
		echo "done"
	else
		# Cloud sync is optional: the local engram daemon works without it.
		echo "optional:not configured"
	fi
}

check_tailscale() {
	if [ "$(uname -s)" = Darwin ]; then
		echo "skip:macOS uses the Tailscale app"
		return
	fi
	if grep -qi microsoft "${POST_RESTORE_PROC_VERSION_FILE:-/proc/version}" 2>/dev/null; then
		echo "skip:WSL uses the Windows Tailscale client"
		return
	fi
	tailscale status >/dev/null 2>&1 && echo "done" || echo "pending"
}

# ZeroTier is a strictly OPTIONAL, independent fallback next to Tailscale: no
# domain to buy, no server to run, phone/desktop apps, and network-level
# access so Moshi/mosh work over it too. Its managed IP range is chosen by
# the user in ZeroTier Central, which lets it dodge 100.64.0.0/10 -- the
# range Tailscale drops on Linux for anything not arriving on tailscale0
# (Tailscale's own util/linuxfw: `! -i tailscale0 -s 100.64.0.0/10 -j DROP`),
# a clash NetBird would hit since NetBird uses that same range. It must never
# affect --check's exit code: an "optional" state here is not "pending".
check_zerotier() {
	if [ "$(uname -s)" = Darwin ]; then
		echo "skip:macOS uses the ZeroTier app"
		return
	fi
	if grep -qi microsoft "${POST_RESTORE_PROC_VERSION_FILE:-/proc/version}" 2>/dev/null; then
		echo "skip:WSL uses the Windows ZeroTier client"
		return
	fi
	if ! command -v zerotier-cli >/dev/null 2>&1; then
		echo "optional:not configured"
		return
	fi
	local out
	# sudo -n never prompts for a password: if the socket needs one, this
	# falls straight through to "optional" instead of blocking --check.
	out=$(zerotier-cli listnetworks 2>/dev/null) || out=$(sudo -n zerotier-cli listnetworks 2>/dev/null) || out=""
	if printf '%s\n' "$out" | grep -qw OK; then
		echo "done"
	else
		echo "optional:not configured"
	fi
}

check_sshd() {
	if [ "$(uname -s)" = Darwin ]; then
		echo "skip:macOS is not covered"
		return
	fi
	local dst="${SSHD_DROPIN_DIR:-/etc/ssh/sshd_config.d}/00-moshi.conf"
	local src="$DOTFILES_PATH/os/linux/ssh/00-moshi.conf"
	if [ -f "$dst" ] && cmp -s "$dst" "$src"; then
		echo "done"
		return
	fi
	if [ ! -s "$HOME/.ssh/authorized_keys" ]; then
		echo "skip:~/.ssh/authorized_keys is empty, applying this first would lock out password login"
		return
	fi
	echo "pending"
}

check_shell() {
	local sh
	sh=$(login_shell_of "$(id -un)")
	case "$sh" in
	*/zsh) echo "done" ;;
	*) echo "pending" ;;
	esac
}

check_moshi() {
	command -v moshi-hook >/dev/null 2>&1 || {
		echo "skip:moshi-hook is not installed"
		return
	}
	local first
	first=$(moshi-hook status 2>/dev/null | head -1)
	if printf '%s' "$first" | grep -Eq '^status:[[:space:]]+paired([[:space:]]|$)'; then
		echo "done"
	else
		echo "info:not paired yet"
	fi
}

check_step() {
	case "$1" in
	gh) check_gh ;;
	ssh-keys) check_ssh_keys ;;
	pi) check_pi ;;
	claude) check_claude ;;
	codex) check_codex ;;
	opencode) check_opencode ;;
	engram-cloud) check_engram ;;
	tailscale) check_tailscale ;;
	zerotier) check_zerotier ;;
	sshd) check_sshd ;;
	shell) check_shell ;;
	moshi) check_moshi ;;
	esac
}

# --- instructions shown before the generic "Run it now?" prompt --------------
print_step_instructions() {
	case "$1" in
	gh) echo "GitHub CLI is not logged in." ;;
	pi)
		cat <<'EOF'
Pi is not logged in with OpenAI (ChatGPT).
Run `pi`, then type /login and pick the OpenAI ChatGPT subscription.
On a remote machine, paste the final redirect URL back into Pi when asked.
EOF
		;;
	codex) echo "Codex is not logged in." ;;
	opencode) echo "opencode is not logged in." ;;
	engram-cloud)
		cat <<'EOF'
Engram cloud sync is not configured (optional, skip with Enter).
Alternative: copy ~/.engram/cloud.json from another machine with scp.
EOF
		;;
	tailscale)
		if command -v tailscale >/dev/null 2>&1; then
			echo "Tailscale is installed but not logged in."
		else
			echo "Tailscale is not installed."
		fi
		;;
	sshd) echo "sshd hardening (00-moshi.conf) is not applied yet." ;;
	shell) echo "Login shell is not zsh." ;;
	esac
}

# --- actions -------------------------------------------------------------------
run_tailscale_action() {
	if ! command -v tailscale >/dev/null 2>&1; then
		curl -fsSL "${TAILSCALE_INSTALL_URL:-https://tailscale.com/install.sh}" | sh
		return
	fi
	sudo tailscale up
	sudo tailscale set --operator="$(id -un)"
	echo "Remember to disable key expiry for this machine in the admin console."
}

run_zerotier_action() {
	if ! command -v zerotier-cli >/dev/null 2>&1; then
		if ask_yn "zerotier-cli is not installed. Install it now via the official installer (curl | sudo bash)?" Y; then
			local zt_tmp
			zt_tmp=$(mktemp)
			curl -fsSL "${ZEROTIER_INSTALL_URL:-https://install.zerotier.com}" -o "$zt_tmp" &&
				sudo bash "$zt_tmp"
			rm -f "$zt_tmp"
			unset zt_tmp
		fi
		if ! command -v zerotier-cli >/dev/null 2>&1; then
			echo "zerotier-cli is still not available; skipping ZeroTier setup."
			return
		fi
	fi

	cat <<'EOF'
Create a network at https://my.zerotier.com (or reuse one), keep it Private,
and set its Managed Route / IP pool to a private range OUTSIDE 100.64.0.0/10
-- for example 10.147.17.0/24 -- so it never clashes with the range Tailscale
reserves for itself.
EOF

	local zt_id
	zt_id=$(read_visible "ZeroTier network ID (16 hex digits):")
	if ! printf '%s' "$zt_id" | grep -Eqi '^[0-9a-f]{16}$'; then
		echo "That is not a 16-hex-digit network ID, try again."
		zt_id=$(read_visible "ZeroTier network ID (16 hex digits):")
	fi
	if ! printf '%s' "$zt_id" | grep -Eqi '^[0-9a-f]{16}$'; then
		echo "Still not a valid network ID; skipping ZeroTier join."
		unset zt_id
		return
	fi

	sudo zerotier-cli join "$zt_id"
	unset zt_id
	echo "Now authorize this member in ZeroTier Central: my.zerotier.com -> your network -> Members tab."
	sudo zerotier-cli listnetworks

	cat <<'EOF'

Client side: install the ZeroTier app on your laptop/phone, join the same
network ID, authorize it in Members too, then:
  ssh <user>@<this machine's ZeroTier IP>
Consider an untracked ~/.ssh/config.d/ entry:
  Host <vm>-zt
    HostName <this machine's ZeroTier IP>
    User <user>
EOF
}

run_sshd_action() {
	local dir="${SSHD_DROPIN_DIR:-/etc/ssh/sshd_config.d}"
	local src="$DOTFILES_PATH/os/linux/ssh/00-moshi.conf"
	sudo install -m 644 "$src" "$dir/00-moshi.conf"
	sudo rm -f "$dir/99-moshi.conf"
	sudo systemctl restart ssh
	echo "Current PasswordAuthentication setting:"
	sudo sshd -T | grep -i '^passwordauthentication'
}

run_engram_action() {
	local server token dir="$HOME/.engram" file="$HOME/.engram/cloud.json" tmp
	server=$(read_visible "Engram cloud server URL:")
	token=$(read_secret "Engram cloud token (hidden):")
	umask 077
	mkdir -p "$dir"
	chmod 700 "$dir"
	tmp=$(mktemp "$dir/cloud.json.XXXXXX")
	# The token goes through the environment, not argv: argv is visible to
	# every user in `ps`, the environment only to this user.
	ENGRAM_SECRET_TOKEN="$token" jq -n --arg s "$server" '{server_url: $s, token: env.ENGRAM_SECRET_TOKEN}' >"$tmp"
	chmod 600 "$tmp"
	mv "$tmp" "$file"
	if systemctl --user list-unit-files --no-legend 2>/dev/null | grep -q '^engram-serve\.service'; then
		systemctl --user restart engram-serve.service
	fi
}

run_action() {
	case "$1" in
	gh) gh auth login --hostname github.com --git-protocol ssh --web --skip-ssh-key --scopes admin:public_key ;;
	pi) pi ;;
	codex) codex login --device-auth ;;
	opencode) opencode auth login ;;
	tailscale) run_tailscale_action ;;
	sshd) run_sshd_action ;;
	shell) sudo chsh -s "$(command -v zsh)" "$(id -un)" ;;
	engram-cloud) run_engram_action ;;
	esac
}

# --- ssh key labels: keep the account-detection comment format in sync with
# the one generated here, so a freshly generated key is recognized right away
# by account_ssh_entry: "<user>@<host>[ <label>]".
prompt_key_label() {
	read_visible "Label for this key's account (e.g. personal, work) [none]:"
}

keygen_comment() {
	local base label="$1"
	base="$(id -un)@$(hostname)"
	if [ -n "$label" ]; then
		printf '%s %s' "$base" "$label"
	else
		printf '%s' "$base"
	fi
}

# --- ssh-keys: one prompt per missing key, then a github.com verification ----
run_ssh_keys() {
	# Read every entry into an array first, rather than piping
	# `list_identity_files` straight into a `while read` loop: that classic
	# form redirects the loop body's stdin from the process substitution, so
	# the interactive `ask_yn`/read calls inside the loop would read from the
	# key list instead of the user's answers.
	local config="$DOTFILES_PATH/ssh/config" entry host path entries
	mapfile -t entries < <(list_identity_files "$config")
	for entry in "${entries[@]}"; do
		IFS=$'\t' read -r host path <<<"$entry"
		[ -z "$path" ] && continue
		if [ -f "$path" ]; then
			echo "✓ SSH key for $host ($path)"
			continue
		fi
		echo "Missing SSH key for $host: $path"
		if ask_yn "Generate it now?" Y; then
			mkdir -p "$(dirname "$path")"
			if [ "$host" = "github.com" ]; then
				ssh-keygen -t ed25519 -f "$path" -C "$(id -un)@$(hostname)"
			else
				local label
				label=$(prompt_key_label)
				ssh-keygen -t ed25519 -f "$path" -C "$(keygen_comment "$label")"
			fi
		fi
		if [ ! -f "$path" ]; then
			echo "still pending: $path"
			continue
		fi
		echo "✓ generated $path"
		if [ "$host" = "github.com" ] && gh auth status >/dev/null 2>&1; then
			if ask_yn "Add it to GitHub with gh now?" Y; then
				gh ssh-key add "${path}.pub" --title "$(hostname)"
			fi
		else
			echo "Add this public key to $host's account:"
			cat "${path}.pub" 2>/dev/null
		fi
	done

	if list_identity_files "$config" | cut -f1 | grep -qx github.com; then
		if ssh -T -o BatchMode=yes git@github.com 2>&1 | grep -qF 'successfully authenticated'; then
			echo "✓ github.com SSH authentication verified"
		else
			echo "github.com SSH authentication: still pending"
		fi
	fi
}

# --- claude: login, then always check the codegraph MCP registration --------
maybe_register_codegraph() {
	local claude_json="$HOME/.claude.json"
	[ -f "$claude_json" ] || return 0
	jq -e '.mcpServers.codegraph' "$claude_json" >/dev/null 2>&1 && return 0
	echo "Registering the codegraph MCP server for Claude Code..."
	(DOTFILES_PATH="$DOTFILES_PATH" bash -c '. "$DOTFILES_PATH/restoration_scripts/11-codegraph.sh"')
}

process_claude() {
	local label="${STEP_LABEL[claude]}" state
	state=$(check_claude)
	if [ "$state" = pending ]; then
		echo "Claude Code is not logged in."
		if ask_yn "Run it now?" Y; then
			claude auth login
		fi
		state=$(check_claude)
	fi
	if [ "$state" = "done" ]; then
		echo "✓ $label"
	else
		echo "$label: still pending"
	fi
	maybe_register_codegraph
	RESULT[claude]="$state"
}

process_ssh_keys() {
	local label="${STEP_LABEL[ssh-keys]}" state
	state=$(check_step ssh-keys)
	if [ "$state" = "done" ]; then
		echo "✓ $label"
		RESULT[ssh-keys]="done"
		return
	fi
	run_ssh_keys
	state=$(check_step ssh-keys)
	if [ "$state" = "done" ]; then
		echo "✓ $label"
	else
		echo "$label: still pending"
	fi
	RESULT[ssh-keys]="$state"
}

process_moshi() {
	local label="${STEP_LABEL[moshi]}" state
	state=$(check_step moshi)
	case "$state" in
	done) echo "✓ $label" ;;
	skip:*) echo "- $label: skipped (${state#skip:})" ;;
	info:*)
		cat <<EOF
$label is optional and not paired yet. Pairing commands (run by hand, the
last one needs a QR your device scans, so nothing here runs automatically):
  moshi-hook pair --token <token from the app> --store file
  moshi-hook service install
  moshi-hook host setup --host "$(hostname)" --user "$(id -un)" --port 22
EOF
		;;
	esac
	RESULT[moshi]="$state"
}

process_zerotier() {
	local label="${STEP_LABEL[zerotier]}" state
	state=$(check_step zerotier)
	case "$state" in
	done)
		echo "✓ $label"
		RESULT[zerotier]="$state"
		return
		;;
	skip:*)
		echo "- $label: skipped (${state#skip:})"
		RESULT[zerotier]="$state"
		return
		;;
	esac
	if ask_yn "Set up ZeroTier as an optional fallback?" N; then
		run_zerotier_action
		state=$(check_step zerotier)
	fi
	if [ "$state" = "done" ]; then
		echo "✓ $label"
	else
		echo "- $label: optional (${state#optional:})"
	fi
	RESULT[zerotier]="$state"
}

process_generic() {
	local id="$1" label state default
	label="${STEP_LABEL[$id]}"
	state=$(check_step "$id")
	case "$state" in
	done)
		echo "✓ $label"
		RESULT[$id]="done"
		return
		;;
	skip:*)
		echo "- $label: skipped (${state#skip:})"
		RESULT[$id]="$state"
		return
		;;
	esac
	print_step_instructions "$id"
	default=Y
	[ "$id" = engram-cloud ] && default=N
	if ask_yn "Run it now?" "$default"; then
		run_action "$id"
	fi
	state=$(check_step "$id")
	case "$state" in
	done) echo "✓ $label" ;;
	optional:*) echo "- $label: optional (${state#optional:})" ;;
	*) echo "$label: still pending" ;;
	esac
	RESULT[$id]="$state"
}

process_step() {
	case "$1" in
	ssh-keys) process_ssh_keys ;;
	claude) process_claude ;;
	moshi) process_moshi ;;
	zerotier) process_zerotier ;;
	*) process_generic "$1" ;;
	esac
}

# --- summary table, shared by --check and the end of the interactive run ----
render_status() {
	case "$1" in
	done) echo "✓" ;;
	pending) echo "pending" ;;
	skip:*) echo "skip (${1#skip:})" ;;
	info:*) echo "pending (optional, ${1#info:})" ;;
	optional:*) echo "optional (${1#optional:})" ;;
	esac
}

STATUS_COL_WIDTH=32

truncate_status() {
	local s="$1" w="$2"
	if [ "${#s}" -gt "$w" ]; then
		printf '%s…' "${s:0:$((w - 1))}"
	else
		printf '%s' "$s"
	fi
}

# pad_to <text> <width>: pads by characters. printf's %-Ns pads by bytes, so a
# multibyte status such as "✓" (3 bytes) came out 2 columns short.
pad_to() {
	local s="$1" w="$2" n
	n=$(LC_ALL=C.UTF-8 bash -c 'printf %s "${#1}"' _ "$s" 2>/dev/null) || n=${#s}
	printf '%s' "$s"
	[ "$n" -lt "$w" ] && printf '%*s' "$((w - n))" ''
	return 0
}
print_summary() {
	echo
	printf '%-13s %s %s\n' "STEP" "$(pad_to STATUS 32)" "ACCOUNT"
	local id
	for id in "${STEP_ORDER[@]}"; do
		printf '%-13s %s %s\n' "$id" \
			"$(pad_to "$(truncate_status "$(render_status "${RESULT[$id]}")" "$STATUS_COL_WIDTH")" 32)" \
			"${ACCOUNT_RESULT[$id]:--}"
	done
}

summary_exit_code() {
	local id
	for id in "${STEP_ORDER[@]}"; do
		[ "${RESULT[$id]}" = pending ] && return 1
	done
	return 0
}

run_check_only() {
	local id
	for id in "${STEP_ORDER[@]}"; do
		RESULT[$id]=$(check_step "$id")
	done
	populate_accounts
	print_summary
	summary_exit_code
}

run_interactive() {
	local id
	for id in "${STEP_ORDER[@]}"; do
		process_step "$id"
	done
	populate_accounts
	print_summary
	summary_exit_code
}

# --- --menu: interactive table + per-step account switching ----------------
print_menu_table() {
	echo
	printf '%-3s %-13s %s %s\n' "N" "STEP" "$(pad_to STATUS 32)" "ACCOUNT"
	local i=1 id
	for id in "${STEP_ORDER[@]}"; do
		printf '%-3s %-13s %s %s\n' "$i" "$id" \
			"$(pad_to "$(truncate_status "$(render_status "${RESULT[$id]}")" "$STATUS_COL_WIDTH")" 32)" \
			"${ACCOUNT_RESULT[$id]:--}"
		i=$((i + 1))
	done
}

menu_switch_gh() {
	local acc="${ACCOUNT_RESULT[gh]:--}"
	if [ "$acc" != "-" ] && gh auth logout --help 2>&1 | grep -q -- '--user'; then
		gh auth logout --hostname github.com --user "$acc"
	else
		echo y | gh auth logout --hostname github.com
	fi
	run_action gh
}

# Lists every key with an existing private file (index, host, path,
# fingerprint, detected account), then replaces the chosen one: the old pair
# is moved into ~/.ssh/retired/ with a timestamp suffix (never deleted)
# before a fresh key is generated in its place.
menu_switch_ssh_keys() {
	local config="$DOTFILES_PATH/ssh/config" entries entry host path
	mapfile -t entries < <(list_identity_files "$config")
	local -a m_hosts=() m_paths=()
	local i=0 fp acc
	for entry in "${entries[@]}"; do
		IFS=$'\t' read -r host path <<<"$entry"
		[ -z "$path" ] && continue
		[ -f "$path" ] || continue
		i=$((i + 1))
		m_hosts+=("$host")
		m_paths+=("$path")
		fp=$(ssh-keygen -lf "${path}.pub" 2>/dev/null)
		acc=$(account_ssh_entry "$host" "$path")
		printf '%d) %-15s %-30s %-50s %s\n' "$i" "$host" "$path" "$fp" "$acc"
	done
	if [ "$i" -eq 0 ]; then
		echo "No SSH keys to replace."
		return
	fi
	local choice
	choice=$(read_visible "Which key to replace? (Enter to cancel):")
	[ -z "$choice" ] && return
	case "$choice" in
	*[!0-9]*)
		echo "Invalid choice."
		return
		;;
	esac
	if [ "$choice" -lt 1 ] || [ "$choice" -gt "$i" ]; then
		echo "Invalid choice."
		return
	fi
	local sel_host="${m_hosts[$((choice - 1))]}" sel_path="${m_paths[$((choice - 1))]}"
	local old_fp
	old_fp=$(ssh-keygen -lf "${sel_path}.pub" 2>/dev/null)
	local retired_dir="$HOME/.ssh/retired" ts
	mkdir -p "$retired_dir"
	chmod 700 "$retired_dir"
	ts=$(date +%Y%m%d-%H%M%S)
	mv "$sel_path" "$retired_dir/$(basename "$sel_path").${ts}"
	mv "${sel_path}.pub" "$retired_dir/$(basename "$sel_path").pub.${ts}"
	local label
	label=$(prompt_key_label)
	ssh-keygen -t ed25519 -f "$sel_path" -N "" -C "$(keygen_comment "$label")"
	if [ "$sel_host" = "github.com" ]; then
		if gh auth status >/dev/null 2>&1; then
			gh ssh-key add "${sel_path}.pub" --title "$(hostname)"
		fi
		echo "Delete the old key at github.com/settings/keys (fingerprint: $old_fp)"
	else
		echo "New public key for $sel_host:"
		cat "${sel_path}.pub" 2>/dev/null
		if [ "$sel_host" = "bitbucket.org" ]; then
			echo "Bitbucket -> Personal settings -> SSH keys -> Add key"
		else
			echo "Add this key to $sel_host's account."
		fi
		echo "Then remove the old key (fingerprint: $old_fp) from the account where it was."
	fi
}

menu_switch_engram() {
	local f="$HOME/.engram/cloud.json" backup
	if [ -f "$f" ]; then
		backup="${f}.bak.$(date +%Y%m%d-%H%M%S)"
		cp "$f" "$backup"
		chmod 600 "$backup"
	fi
	run_engram_action
}

menu_switch_account() {
	local id="$1"
	case "$id" in
	gh) menu_switch_gh ;;
	ssh-keys) menu_switch_ssh_keys ;;
	claude)
		claude auth logout
		claude auth login
		;;
	codex)
		codex logout
		codex login --device-auth
		;;
	opencode)
		opencode auth logout
		opencode auth login
		;;
	pi)
		cat <<'EOF'
In Pi, switch accounts by hand:
  /logout
  /login
EOF
		if ask_yn "Launch pi now?" Y; then
			pi
		fi
		;;
	engram-cloud) menu_switch_engram ;;
	tailscale)
		cat <<'EOF'
Switching the tailnet account ends every Tailscale connection, including an
SSH session over Tailscale. Run this from the machine's console or a LAN
session, not over Tailscale:
  sudo tailscale logout
  sudo tailscale up
EOF
		;;
	zerotier | sshd | shell | moshi) process_step "$id" ;;
	esac
}

menu_handle_step() {
	local id="$1" label="${STEP_LABEL[$1]}" acc="${ACCOUNT_RESULT[$1]:--}"
	if [ "${RESULT[$id]}" = "done" ]; then
		if ask_yn "$label is configured as $acc. Reconfigure / switch account?" N; then
			menu_switch_account "$id"
		fi
	else
		process_step "$id"
	fi
}

run_menu() {
	local id
	for id in "${STEP_ORDER[@]}"; do
		RESULT[$id]=$(check_step "$id")
	done
	populate_accounts
	while true; do
		print_menu_table
		local reply rc
		if have_tty; then
			exec 3</dev/tty
			read -r -p "Choose a step number, r to refresh, q to quit: " reply <&3
			rc=$?
			exec 3<&-
		else
			printf 'Choose a step number, r to refresh, q to quit: '
			read -r reply
			rc=$?
		fi
		if [ "$rc" -ne 0 ]; then
			return 0
		fi
		case "$reply" in
		q | Q)
			return 0
			;;
		r | R)
			for id in "${STEP_ORDER[@]}"; do
				RESULT[$id]=$(check_step "$id")
			done
			populate_accounts
			;;
		*[!0-9]* | "")
			echo "Invalid choice."
			;;
		*)
			if [ "$reply" -lt 1 ] || [ "$reply" -gt "${#STEP_ORDER[@]}" ]; then
				echo "Invalid choice."
			else
				id="${STEP_ORDER[$((reply - 1))]}"
				menu_handle_step "$id"
				RESULT[$id]=$(check_step "$id")
				if [ "${NO_ACCOUNTS:-0}" = 1 ]; then
					ACCOUNT_RESULT[$id]="-"
				else
					ACCOUNT_RESULT[$id]=$(account_of "$id")
				fi
			fi
			;;
		esac
	done
}

main() {
	local check_only=0 menu_only=0
	for arg in "$@"; do
		case "$arg" in
		--check) check_only=1 ;;
		--menu) menu_only=1 ;;
		--no-accounts) NO_ACCOUNTS=1 ;;
		esac
	done

	if [ -n "${POST_RESTORE_ONLY:-}" ]; then
		case " ${STEP_ORDER[*]} " in
		*" $POST_RESTORE_ONLY "*) STEP_ORDER=("$POST_RESTORE_ONLY") ;;
		*)
			echo "Unknown POST_RESTORE_ONLY step: $POST_RESTORE_ONLY" >&2
			exit 2
			;;
		esac
	fi

	if [ "$menu_only" = 1 ]; then
		run_menu
	elif [ "$check_only" = 1 ]; then
		run_check_only
	else
		run_interactive
	fi
}

main "$@"
