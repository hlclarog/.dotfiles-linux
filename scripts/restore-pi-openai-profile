#!/usr/bin/env python3
"""Manually restore the allowlisted Pi OpenAI profile without changing active selection."""

import json
import math
import os
from pathlib import Path
import stat
import sys
import tempfile

NAME = "open-ai-full.autogen"
KIND = "gentle-pi.agent_model_profiles"
THINKING = {"off", "minimal", "low", "medium", "high", "xhigh", "max"}
SOURCE = Path(__file__).resolve().parent.parent / "config/pi/open-ai-full.autogen.json"
TARGET = Path.home() / ".pi/gentle-ai/profiles.json"


class UnsafeRestore(Exception):
    """An input is invalid or would require an overwrite."""


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON key")
        result[key] = value
    return result


def reject_nonfinite(value):
    raise ValueError("non-finite JSON number")


def finite_float(value):
    parsed = float(value)
    if not math.isfinite(parsed):
        raise ValueError("non-finite JSON number")
    return parsed


def decode(data):
    return json.loads(data, object_pairs_hook=unique_object,
                      parse_constant=reject_nonfinite, parse_float=finite_float)


def validated_source():
    try:
        profile = decode(SOURCE.read_bytes())
    except (OSError, ValueError, UnicodeError) as exc:
        raise UnsafeRestore("Source profile is missing or invalid; no registry was changed.") from exc
    if (not isinstance(profile, dict) or len(profile) != 26 or
            any(not isinstance(role, str) or not isinstance(entry, dict) or
                set(entry) != {"model", "thinking"} or
                type(entry["model"]) is not str or
                not entry["model"].startswith("openai-codex/") or
                type(entry["thinking"]) is not str or
                entry["thinking"] not in THINKING
                for role, entry in profile.items())):
        raise UnsafeRestore("Source profile is invalid; no registry was changed.")
    return profile


def current_registry():
    try:
        info = TARGET.lstat()
    except FileNotFoundError:
        return None, None, None
    if not stat.S_ISREG(info.st_mode):
        raise UnsafeRestore("Registry is not a regular file (symlinks are refused); inspect it manually.")
    try:
        fd = os.open(TARGET, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd, "rb") as file:
            if not stat.S_ISREG(os.fstat(file.fileno()).st_mode):
                raise UnsafeRestore("Registry is not a regular file; inspect it manually.")
            raw = file.read()
            opened = os.fstat(file.fileno())
        registry = decode(raw)
    except (OSError, ValueError, UnicodeError) as exc:
        raise UnsafeRestore("Registry is unreadable or malformed; inspect it manually.") from exc
    if (not isinstance(registry, dict) or registry.get("kind") != KIND or
            type(registry.get("version")) is not int or registry["version"] != 1 or
            not isinstance(registry.get("profiles"), dict) or
            not isinstance(registry.get("active"), str)):
        raise UnsafeRestore("Registry has an unsupported schema; inspect it manually.")
    if (opened.st_dev, opened.st_ino) != (info.st_dev, info.st_ino):
        raise UnsafeRestore("Registry changed during read; inspect it manually.")
    return registry, raw, info


def private_file(directory, prefix, data):
    fd, path = tempfile.mkstemp(prefix=prefix, dir=directory)
    try:
        with os.fdopen(fd, "wb") as file:
            file.write(data)
            file.flush()
            os.fsync(file.fileno())
    except BaseException:
        os.unlink(path)
        raise
    return path


def restore(replace=False):
    profile = validated_source()
    registry, original, info = current_registry()
    if registry is not None:
        existing = registry["profiles"].get(NAME)
        if NAME in registry["profiles"]:
            if existing == profile:
                print("Profile already present; registry unchanged.")
                return
            if not replace:
                raise UnsafeRestore("Profile key conflicts with the trusted source; inspect it manually. Nothing changed.")
        registry["profiles"][NAME] = profile
    else:
        registry = {"kind": KIND, "version": 1, "profiles": {NAME: profile}, "active": NAME}
        TARGET.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        if not stat.S_ISDIR(TARGET.parent.stat().st_mode) or TARGET.parent.stat().st_mode & 0o077:
            raise UnsafeRestore("Registry directory is not private; inspect it manually.")

    encoded = (json.dumps(registry, indent=2, ensure_ascii=False) + "\n").encode("utf-8")
    pending = private_file(TARGET.parent, ".profiles.json.pending-", encoded)
    try:
        if info is not None:
            try:
                now = TARGET.lstat()
            except FileNotFoundError as exc:
                raise UnsafeRestore("Registry changed during restore; inspect it manually.") from exc
            if (not stat.S_ISREG(now.st_mode) or
                    (now.st_dev, now.st_ino, now.st_size, now.st_mtime_ns) !=
                    (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns)):
                raise UnsafeRestore("Registry changed during restore; inspect it manually.")
            # The backup is the exact old bytes, never a re-serialized copy.
            private_file(TARGET.parent, "profiles.json.backup-", original)
        elif TARGET.exists() or TARGET.is_symlink():
            raise UnsafeRestore("Registry appeared during restore; inspect it manually.")
        os.replace(pending, TARGET)
    finally:
        if os.path.exists(pending):
            os.unlink(pending)
    print("Profile restored. Restart Pi to reload its registry; existing active selection was preserved.")


def main():
    if sys.argv[1:] not in ([], ["--replace"]):
        print("Usage: restore-pi-openai-profile [--replace]", file=sys.stderr)
        return 2
    try:
        restore(replace=sys.argv[1:] == ["--replace"])
    except (UnsafeRestore, OSError, ValueError) as exc:
        if isinstance(exc, UnsafeRestore):
            print(f"Restore refused: {exc}", file=sys.stderr)
        else:
            print("Restore failed safely; inspect registry and any private backup manually.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
